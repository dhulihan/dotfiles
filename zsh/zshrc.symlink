# capture shell start time to measure total load time
ZSH_START_TIME=$(gdate +%s.%N)

# if we already loaded, perform verbose logging
if [[ $ZSH_LOADED == true ]] ; then
	export LOG_LEVEL=${LOG_LEVEL:-info}
else
	export LOG_LEVEL=${LOG_LEVEL:-info}
fi

if [[ $LOG_LEVEL == "trace" ]]; then
	# start profiling
	zmodload zsh/zprof
fi

# logger
PREV_TIME=$(gdate +%s.%N)
debug() {
	CURR_TIME=$(gdate +%s.%N)
	ELAPSED=$(echo "$CURR_TIME - $PREV_TIME" | bc)
	if [[ $LOG_LEVEL == "debug" ]]; then
		echo "$fg_bold[grey]$(gdate --iso-8601=ns) $fg_bold[grey]$1 $fgbold[yellow]${ELAPSED}s"
	fi

	PREV_DATE=$CURR_DATE
}

info() {
	if [[ $LOG_LEVEL == "info" || $LOG_LEVEL == "debug" ]]; then
		echo "$fg_bold[grey]$(gdate --iso-8601=ns) $fg_bold[green]$1"
	fi
}

warn() {
	echo "$fg_bold[grey]$(gdate --iso-8601=ns) $fg_bold[yellow]$1"
}


# your project folder that we can `c [tab]` to
export PROJECTS=$HOME/Projects
export CDPATH=$PROJECTS:$CDPATH
# shortcut to this dotfiles path is $ZSH
#
export ZSH=$HOME/.dotfiles
export SHELL=$(which zsh)

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
debug "$HOME/.localrc"
if [[ -a $HOME/.localrc ]]
then
  source $HOME/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)
sh_common_files=($ZSH/**/*.sh-common)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  debug "about to load $file"
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  debug "about to load $file"
  source $file
done

# load common sh files
for file in ${${sh_common_files}}
do
  debug "about to load $file"
  source $file
done

# enable bash completion for tools that only have bash completion support (aws, etc)
debug "bashcompinit"
autoload -U +X bashcompinit && bashcompinit

# initialize autocomplete here, otherwise functions won't be loaded
# only reload compinit every 24h
debug "compinit check"
autoload -Uz compinit
# Rebuild the dump at most once every 24h; otherwise load the cached one fast.
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -n "$_zcompdump"(#qN.mh+24) ]]; then
  compinit -d "$_zcompdump"          # full scan + security check + rewrite dump
else
  compinit -C -d "$_zcompdump"       # skip checks, just load the dump — fast
fi
unset _zcompdump

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  debug "about to load $file"
  source $file
done

unset config_files

export EDITOR=nvim

# shift-tab reverse complete
bindkey '^[[Z' reverse-menu-complete

# allow C-a | C-e in tmux
bindkey -e
bindkey '^R' history-incremental-search-backward

# prepend space allow
setopt histignorespace

# Load this manually, since fzf breaks in tmux if out of order
debug "$HOME/.fzf.zsh"
[ -f $HOME/.fzf.zsh ] && source $HOME/.fzf.zsh

export ZSH_LOADED=true

# print total shell load time
ZSH_END_TIME=$(gdate +%s.%N)
ZSH_LOAD_TIME=$(echo "$ZSH_END_TIME - $ZSH_START_TIME" | bc)
info "shell loaded in ${ZSH_LOAD_TIME}s"

if [[ $LOG_LEVEL == "trace" ]]; then
	# finish profiling
	zprof
fi

# show selection box on completion items
zstyle ':completion:*' menu select

# reverse select
bindkey '^[[Z' reverse-menu-complete              # main keymap: step back through matches
bindkey -M menuselect '^[[Z' reverse-menu-complete # inside the menu

# set up dev session on cd
chpwd_functions=(${chpwd_functions[@]} "dev-session")
