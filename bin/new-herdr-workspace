#!/bin/sh
set -eu

# resolve sibling scripts relative to this file (popup PATH may be minimal)
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# list immediate subdirectories of every CDPATH entry (the dirs `cd <name>` resolves)
list_dirs() {
  IFS=:
  for d in ${CDPATH:-}; do
    case "$d" in ""|.) continue ;; esac
    [ -d "$d" ] || continue
    fd --type d --max-depth 1 . "$d" 2>/dev/null
  done
}

dir=$(list_dirs | awk '!seen[$0]++' | fzf --prompt="new workspace in > ") || exit 0
[ -n "${dir:-}" ] || exit 0
"$bindir/herdr-open-workspace" "$dir"
