#!/bin/sh

# Pull master only when the repo has no recent commits.
# If the last commit is older than the threshold, check out main/master and
# pull. Otherwise leave the current branch untouched.
# Usage: git-pull-if-stale [day-threshold]   (default: 7)

set -eu

threshold="${1:-7}"

# must be inside a git work tree
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "not a git repo, skipping pull" >&2
  exit 0
fi

# days since the last commit (see functions/git-days-since-last-commit)
last_commit_epoch=$(git log -1 --pretty=format:%ct 2>/dev/null || echo "")
if [ -z "$last_commit_epoch" ]; then
  echo "no commits yet, skipping pull" >&2
  exit 0
fi
now_epoch=$(date +%s)
days_since=$(( (now_epoch - last_commit_epoch) / 86400 ))

if [ "$days_since" -le "$threshold" ]; then
  echo "$days_since days since last commit, staying on current branch"
  exit 0
fi

echo "$days_since days since last commit, checking out master and pulling"
git checkout master 2>/dev/null || git checkout main
git pull origin
