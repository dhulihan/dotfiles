alias assume="source /opt/homebrew/bin/assume"
# https://docs.commonfate.io/granted/internals/shell-alias
export GRANTED_ALIAS_CONFIGURED="true"

# service-specific
alias acm="assume --terminal -s acm"
alias apigateway="assume --terminal -s apigateway"
alias athena="assume --terminal -s athena"
alias cloudformation="assume --terminal -s cloudformation"
alias cloudfront="assume --terminal -s cloudfront"
alias cloudtrail="assume --terminal -s cloudtrail"
alias cloudwatch="assume --terminal -s cloudwatch"
alias codebuild="assume --terminal -s codebuild"
alias codedeploy="assume --terminal -s codedeploy"
alias codepipeline="assume --terminal -s codepipeline"
alias cognito="assume --terminal -s cognito"
alias cw="cloudwatch"
alias dynamo="assume --terminal -s dynamodb"
alias ec2="assume --terminal -s ec2"
alias ecr="assume --terminal -s ecr"
alias ecs="assume --terminal -s ecs"
alias efs="assume --terminal -s efs"
alias eks="assume --terminal -s eks"
alias elasticache="assume --terminal -s elasticache"
alias elb="assume --terminal -s elbv2"
alias eventbridge="assume --terminal -s eventbridge"
alias glue="assume --terminal -s glue"
alias iam="assume --terminal -s iam"
alias kinesis="assume --terminal -s kinesis"
alias kms="assume --terminal -s kms"
alias lambda="assume --terminal -s lambda"
alias log-analytics="assume --terminal -s cloudwatch#log-analytics"
alias logs="assume --terminal -cd 'https://us-east-1.console.aws.amazon.com/cloudwatch/home?region=us-east-1#log-analytics'"
alias logs-west-2="assume --terminal -cd 'https://us-west-2.console.aws.amazon.com/cloudwatch/home?region=us-west-2#log-analytics'"
alias rds="assume --terminal -s rds"
alias redshift="assume --terminal -s redshift"
alias route53="assume --terminal -s route53"
alias s3="assume --terminal -s s3"
alias secretsmanager="assume --terminal -s secretsmanager"
alias ses="assume --terminal -s ses"
alias sns="assume --terminal -s sns"
